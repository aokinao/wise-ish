{
  "schemaVersion": 1,
  "catalogVersion": "2026-08-30.1",
  "quotes": [
    {
      "id": "quiet-1",
      "mood": "quiet",
      "text": "選ばなかった道は美しく見える。\nたぶん工事区間を見ておらんからじゃ。",
      "theme": "選択について",
      "aside": "知らんけどの。",
      "tags": [
        "daily",
        "creative"
      ]
    },
    {
      "id": "quiet-2",
      "mood": "quiet",
      "text": "世界の流れは、立ち止まった者にも届く。\n鳩がその証明のように、こちらへ歩いてくる。",
      "theme": "休息について",
      "aside": "鳩は急いでおる。",
      "tags": [
        "rest",
        "daily"
      ]
    },
    {
      "id": "quiet-3",
      "mood": "quiet",
      "text": "何もない場所は、何かを置ける場所でもある。\n空いた皿に、団子を一つだけ置いてみた。",
      "theme": "余白について",
      "aside": "二つ目は明日にするかの。",
      "tags": [
        "rest",
        "daily"
      ]
    },
    {
      "id": "quiet-4",
      "mood": "quiet",
      "text": "分からぬものを、分かった顔で選ぶのは危うい。\n献立を読まずに豆腐を頼み、冷奴が来てから気づいた。",
      "theme": "人について",
      "aside": "眼鏡を忘れたんじゃ。",
      "tags": [
        "relationship",
        "daily"
      ]
    },
    {
      "id": "quiet-5",
      "mood": "quiet",
      "text": "休息も長い旅の一部じゃ。\nわしは出発前から、その部分におる。",
      "theme": "歩みについて",
      "aside": "先に座っとる。",
      "tags": [
        "rest",
        "work"
      ]
    },
    {
      "id": "quiet-6",
      "mood": "quiet",
      "text": "悩みは心が持ち続ける荷物じゃ。\nわしのは重いので、そのへんに置いた。",
      "theme": "悩みについて",
      "aside": "そのへんが、どこか忘れた。",
      "tags": [
        "rest",
        "daily"
      ]
    },
    {
      "id": "quiet-7",
      "mood": "quiet",
      "text": "静けさにも音はある。\n茶が冷める音は聞こえぬが。",
      "theme": "静けさについて",
      "aside": "飲みごろ逃したの。",
      "tags": [
        "rest",
        "daily"
      ]
    },
    {
      "id": "quiet-8",
      "mood": "quiet",
      "text": "何もしない時間にも意味はある。\n意味を探しておるうちに、茶が冷めた。",
      "theme": "予定について",
      "aside": "湯は、まだ残っておる。",
      "tags": [
        "rest",
        "work"
      ]
    },
    {
      "id": "quiet-9",
      "mood": "quiet",
      "text": "自由には、帰る道も含まれておるらしい。\n窓から飛んだ紙を、今日は追わぬことにした。",
      "theme": "風通しについて",
      "aside": "風のほうが速かった。",
      "tags": [
        "daily",
        "money"
      ]
    },
    {
      "id": "quiet-10",
      "mood": "quiet",
      "text": "比べるとは、二つを同じ物差しに載せることじゃ。\n載らぬものを載せようとして、今日も疲れた。",
      "theme": "比較について",
      "aside": "同じ皿には載らんの。",
      "tags": [
        "relationship",
        "daily"
      ]
    },
    {
      "id": "quiet-11",
      "mood": "quiet",
      "text": "団子は分けると減る。これは算数じゃ。\nじゃが、分けた相手は増える。なぜじゃ。",
      "theme": "やさしさについて",
      "aside": "半分でも、記憶は一つじゃ。",
      "tags": [
        "relationship",
        "daily"
      ]
    },
    {
      "id": "quiet-12",
      "mood": "quiet",
      "text": "失敗は経験になるという。\nわしの経験は、棚の上でほこりになっておる。",
      "theme": "失敗について",
      "aside": "くしゃみ出そうじゃ。",
      "tags": [
        "work",
        "daily"
      ]
    },
    {
      "id": "quiet-13",
      "mood": "quiet",
      "text": "孤独は、人がいないことだけではない。\n隣の座布団を片づけた日に、少し広すぎると知った。",
      "theme": "孤独について",
      "aside": "今日は出しておくかの。",
      "tags": [
        "relationship",
        "rest"
      ]
    },
    {
      "id": "quiet-14",
      "mood": "quiet",
      "text": "待つ者には、いつか答えが訪れる。\n湯は見張るほど沸かぬ。見ておるのに、なぜじゃ。",
      "theme": "待つことについて",
      "aside": "今度は背を向けてみる。",
      "tags": [
        "rest",
        "daily"
      ]
    },
    {
      "id": "quiet-15",
      "mood": "quiet",
      "text": "勇気があるかは、踏み出す足に現れる。\n左右の違う靴下でも、一歩は一歩じゃ。",
      "theme": "勇気について",
      "aside": "今日は誰にも会わぬ予定じゃ。",
      "tags": [
        "work",
        "daily"
      ]
    },
    {
      "id": "quiet-16",
      "mood": "quiet",
      "text": "予定のない日は、余白かもしれぬ。\nわしはそこへ昼寝を置いておいた。",
      "theme": "日常について",
      "aside": "明日の欄も空いておる。",
      "tags": [
        "daily",
        "rest"
      ]
    },
    {
      "id": "quiet-17",
      "mood": "quiet",
      "text": "手放すとは、物の続きを自分で決めぬことじゃ。\n古い羽織を人に譲った。翌日、わしより似合っておった。",
      "theme": "手放すことについて",
      "aside": "今日は少し寒い。",
      "tags": [
        "money",
        "daily"
      ]
    },
    {
      "id": "quiet-18",
      "mood": "quiet",
      "text": "歩みの価値は速さでは決まらぬ。\n亀に聞こうとしたが、先に帰った。",
      "theme": "自分の速さについて",
      "aside": "わしはまだ玄関におる。",
      "tags": [
        "work",
        "rest"
      ]
    },
    {
      "id": "quiet-19",
      "mood": "quiet",
      "text": "雨の日は空も休んでおる。\n洗濯物は困っておる。",
      "theme": "雨について",
      "aside": "羽織も、まだ湿っておる。",
      "tags": [
        "rest",
        "daily"
      ]
    },
    {
      "id": "quiet-20",
      "mood": "quiet",
      "text": "夜に深く見えた真理が、朝には消えておる。\n布団の跡のほうが、まだ形を保っとる。",
      "theme": "夜について",
      "aside": "布団が呼んでおる。",
      "tags": [
        "rest",
        "information"
      ]
    },
    {
      "id": "foggy-1",
      "mood": "foggy",
      "text": "自分探しの旅に出た。\n留守だった。",
      "theme": "自分について",
      "aside": "戸口で茶だけ飲んで帰るかの。",
      "tags": [
        "daily",
        "relationship"
      ]
    },
    {
      "id": "foggy-2",
      "mood": "foggy",
      "text": "見えぬ道にも、行き先はあるはずじゃ。\nなければ、ここを休憩所とする。",
      "theme": "不確かさについて",
      "aside": "茶はあったかの。",
      "tags": [
        "rest",
        "daily"
      ]
    },
    {
      "id": "foggy-3",
      "mood": "foggy",
      "text": "時間に預けた問いは、別の問いで戻ることがある。\n片方だけ見つかった靴下が、その例じゃ。",
      "theme": "保留について",
      "aside": "もう片方は考え中かの。",
      "tags": [
        "information",
        "rest"
      ]
    },
    {
      "id": "foggy-4",
      "mood": "foggy",
      "text": "迷いは道を深くする。\n三度曲がったら、道のほうがわしを覚えた。\n知らんけど。",
      "theme": "迷いについて",
      "aside": "ここ、さっきも見た。",
      "tags": [
        "creative",
        "daily"
      ]
    },
    {
      "id": "foggy-5",
      "mood": "foggy",
      "text": "知識が増えるほど、無知も広がる。\n茶柱一本にも、なぜ立つのか分からぬことが多い。",
      "theme": "情報について",
      "aside": "茶は見てよい。",
      "tags": [
        "information",
        "work"
      ]
    },
    {
      "id": "foggy-6",
      "mood": "foggy",
      "text": "忘れるとは、なくすことではない。\n部屋に入った理由だけ、先に帰ったらしい。",
      "theme": "記憶について",
      "aside": "戸は開けたままじゃ。",
      "tags": [
        "daily",
        "information"
      ]
    },
    {
      "id": "foggy-7",
      "mood": "foggy",
      "text": "選び慣れたものを選ぶときも、選んではおる。\n迷った末に、いつもの茶へ戻った。",
      "theme": "選択について",
      "aside": "献立はまだ決まらん。",
      "tags": [
        "information",
        "daily"
      ]
    },
    {
      "id": "foggy-8",
      "mood": "foggy",
      "text": "未来は読めぬが、過ぎたあとは誰でもよく読める。\n朝は傘で半刻迷った。晴れた夕方には、持たなくてよかったと分かった。",
      "theme": "不確かさについて",
      "aside": "傘は一日持っておった。",
      "tags": [
        "daily",
        "work"
      ]
    },
    {
      "id": "foggy-9",
      "mood": "foggy",
      "text": "探すという行いは、それが物であることを前提にしておる。\nわしはやる気を、座布団の下まで探した。",
      "theme": "やる気について",
      "aside": "団子の串はあったぞ。",
      "tags": [
        "work",
        "daily"
      ]
    },
    {
      "id": "foggy-10",
      "mood": "foggy",
      "text": "地図が逆さでも道は道じゃ。\n目的地は困るじゃろうが。",
      "theme": "見方について",
      "aside": "北はどっちかの。",
      "tags": [
        "creative",
        "daily"
      ]
    },
    {
      "id": "foggy-11",
      "mood": "foggy",
      "text": "人の心を予報できれば、傷つかずに済むかもしれぬ。\nわしは毎日曇りと書いて、傘だけ持っておる。",
      "theme": "機嫌について",
      "aside": "晴れたら閉じればよい。",
      "tags": [
        "relationship",
        "daily"
      ]
    },
    {
      "id": "foggy-12",
      "mood": "foggy",
      "text": "沈黙にも言葉があるなら、あくびも返事かもしれぬ。\nわしは先ほどから、よく返事をしておる。",
      "theme": "言葉について",
      "aside": "ふぁ、と出たの。",
      "tags": [
        "relationship",
        "rest"
      ]
    },
    {
      "id": "foggy-13",
      "mood": "foggy",
      "text": "集中とは、追いかけて捕まえるものではない。\n蠅を追うのをやめたら、考えのほうが戻ってきた。",
      "theme": "集中について",
      "aside": "窓は開けておくかの。",
      "tags": [
        "work",
        "information"
      ]
    },
    {
      "id": "foggy-14",
      "mood": "foggy",
      "text": "心配は、こちらが呼ばずとも集まって始まる。\n今夜も会議が開かれた。議事録は取らんでよい。",
      "theme": "心配について",
      "aside": "わしは欠席じゃ。",
      "tags": [
        "work",
        "rest"
      ]
    },
    {
      "id": "foggy-15",
      "mood": "foggy",
      "text": "未来は、決めぬうちは何にでも使える。\n明日の予定を空けておいた。何をするか考えているうちに今日が暮れた。",
      "theme": "未来について",
      "aside": "明日もまだ空いておる。",
      "tags": [
        "daily",
        "creative"
      ]
    },
    {
      "id": "foggy-16",
      "mood": "foggy",
      "text": "多くを持つほど、失うものも増える。\n茶と団子を同時に持って学んだ。団子は無事じゃ。",
      "theme": "手いっぱいについて",
      "aside": "また膝が熱い。",
      "tags": [
        "work",
        "rest"
      ]
    },
    {
      "id": "foggy-17",
      "mood": "foggy",
      "text": "自信は、必要な日に限って留守にする。\n置き手紙はあったが、わしの字は読めん。",
      "theme": "自信について",
      "aside": "湯だけは沸かしておく。",
      "tags": [
        "work",
        "daily"
      ]
    },
    {
      "id": "foggy-18",
      "mood": "foggy",
      "text": "行いの意味は、あとから追いつくことがある。\nわしの昼寝の意味は、まだ道中らしい。",
      "theme": "理由について",
      "aside": "まあ茶は出すがの。",
      "tags": [
        "creative",
        "daily"
      ]
    },
    {
      "id": "foggy-19",
      "mood": "foggy",
      "text": "複雑な問いほど、丁寧にほどくべきじゃ。\n靴ひもなら、靴ごと脱ぐほうが早い。",
      "theme": "複雑さについて",
      "aside": "裸足で行くかの。",
      "tags": [
        "information",
        "work"
      ]
    },
    {
      "id": "foggy-20",
      "mood": "foggy",
      "text": "問いは、尋ねた場所の言葉で答えを返す。\n冷蔵庫へ聞いたら、豆腐だけが冷たく黙っておった。",
      "theme": "答えについて",
      "aside": "しょうがを添えるかの。",
      "tags": [
        "daily",
        "information"
      ]
    },
    {
      "id": "thinking-1",
      "mood": "thinking",
      "text": "人は、分からぬものに名前をつけて安心する。\nわしは昨夜の不眠を、真理と名づけた。",
      "theme": "思考について",
      "aside": "真理は、少し眠い。",
      "tags": [
        "rest",
        "work"
      ]
    },
    {
      "id": "thinking-2",
      "mood": "thinking",
      "text": "答えのない問いは、心に長く居座る。\n布団は一つなので、そろそろ帰ってほしい。",
      "theme": "答えについて",
      "aside": "座布団なら貸せるがの。",
      "tags": [
        "information",
        "rest"
      ]
    },
    {
      "id": "thinking-3",
      "mood": "thinking",
      "text": "答えは追うほど遠ざかるものじゃ。\n座って待つことにした。茶は先に来た。",
      "theme": "答えについて",
      "aside": "茶も待っておる。",
      "tags": [
        "work",
        "information"
      ]
    },
    {
      "id": "thinking-4",
      "mood": "thinking",
      "text": "考えは、時間をかければ深まるとは限らぬ。\n鍋と同じで、見ておらぬ間に底へ張りつく。",
      "theme": "思索について",
      "aside": "火を弱めるぞ。",
      "tags": [
        "creative",
        "work"
      ]
    },
    {
      "id": "thinking-5",
      "mood": "thinking",
      "text": "数字は世界を正確に切り分ける。\n暗算を間違えるたび、わしの中だけ世界が増える。",
      "theme": "数字について",
      "aside": "指が足りん。",
      "tags": [
        "money",
        "work"
      ]
    },
    {
      "id": "thinking-6",
      "mood": "thinking",
      "text": "高く登るほど、正しい場所にいる気がする。\n違う壁の三段目で、住所を思い出した。",
      "theme": "理想について",
      "aside": "降りるほうが長く感じるのじゃ。",
      "tags": [
        "work",
        "creative"
      ]
    },
    {
      "id": "thinking-7",
      "mood": "thinking",
      "text": "遠回りは、目的地とは別の知識を残す。\n効率よく回り道して、途中の厠に詳しくなった。",
      "theme": "効率について",
      "aside": "わしが紙も補充したぞ。",
      "tags": [
        "work",
        "daily"
      ]
    },
    {
      "id": "thinking-8",
      "mood": "thinking",
      "text": "成功の形は、人の数だけ違う。\nわしの物差しは曲がっておるので、全部丸に見える。",
      "theme": "成功について",
      "aside": "まっすぐは、わしには疲れる。",
      "tags": [
        "work",
        "daily"
      ]
    },
    {
      "id": "thinking-9",
      "mood": "thinking",
      "text": "失敗が土になるのは、埋めたときだけじゃ。\n棚に飾ったままでは、種も近づいてこん。",
      "theme": "失敗について",
      "aside": "額縁には入れんでよい。",
      "tags": [
        "work",
        "creative"
      ]
    },
    {
      "id": "thinking-10",
      "mood": "thinking",
      "text": "偶然に任せた決断にも、拾う責任は残る。\nコインは棚の下へ転がり、まだそこにある。",
      "theme": "決断について",
      "aside": "箒の柄で試すかの。",
      "tags": [
        "money",
        "daily"
      ]
    },
    {
      "id": "thinking-11",
      "mood": "thinking",
      "text": "知識は、積んだ高さでは身につかぬ。\n本を枕にした夜、題名だけが頬に残った。",
      "theme": "知恵について",
      "aside": "字が逆じゃ。",
      "tags": [
        "information",
        "rest"
      ]
    },
    {
      "id": "thinking-12",
      "mood": "thinking",
      "text": "真実は、見る位置で形を変える。\n椅子が傾いたので、正しい角度より座れる角度を選んだ。",
      "theme": "真実について",
      "aside": "真実より腰が大事じゃ。",
      "tags": [
        "information",
        "daily"
      ]
    },
    {
      "id": "thinking-13",
      "mood": "thinking",
      "text": "目的を考えながら歩いた。\n用事のほうを忘れた。",
      "theme": "目的について",
      "aside": "足のほうは、よう歩いておる。",
      "tags": [
        "work",
        "daily"
      ]
    },
    {
      "id": "thinking-14",
      "mood": "thinking",
      "text": "未来を読む者は、幾つもの策を持つ。\nわしは駒をなくしたので、全部見守る策にした。",
      "theme": "戦略について",
      "aside": "袖に入っとった。",
      "tags": [
        "work",
        "information"
      ]
    },
    {
      "id": "thinking-15",
      "mood": "thinking",
      "text": "財布は何も語らぬ。\n開くと少し気まずそうじゃ。",
      "theme": "お金について",
      "aside": "小銭が目をそらした。",
      "tags": [
        "money",
        "daily"
      ]
    },
    {
      "id": "thinking-16",
      "mood": "thinking",
      "text": "白い紙には何でも描ける。\n何も描かぬ自由もある。わしは昼寝した。",
      "theme": "創造について",
      "aside": "紙のほうが、わしより強い。",
      "tags": [
        "creative",
        "work"
      ]
    },
    {
      "id": "thinking-17",
      "mood": "thinking",
      "text": "すべての仕事には終わりがある。\nわしの机では、書類の下に隠れて出てこん。",
      "theme": "仕事について",
      "aside": "掘るのは明日にする。",
      "tags": [
        "work",
        "rest"
      ]
    },
    {
      "id": "thinking-18",
      "mood": "thinking",
      "text": "完璧を求めるほど、直さなくてよい場所まで気になり始める。\n丸い団子を直し続けた。食べるころには、指の跡だらけになった。",
      "theme": "完璧について",
      "aside": "味は変わっておらぬ。",
      "tags": [
        "work",
        "rest"
      ]
    },
    {
      "id": "thinking-19",
      "mood": "thinking",
      "text": "心の距離は、近ければよいとは限らぬ。\n茶をこぼされぬくらいが、わしには近い。",
      "theme": "距離について",
      "aside": "わしはここで聞いとる。",
      "tags": [
        "relationship",
        "daily"
      ]
    },
    {
      "id": "thinking-20",
      "mood": "thinking",
      "text": "未来を決めるのは、考えた時間より動いた跡じゃ。\n今日は鉛筆だけが転がり、わしは同じ場所におる。",
      "theme": "明日について",
      "aside": "鉛筆のほうが進んだの。",
      "tags": [
        "work",
        "rest"
      ]
    },
    {
      "id": "quiet-21",
      "mood": "quiet",
      "activeMonths": [
        3,
        4
      ],
      "text": "桜は散るから美しいという。\n散ったあとまで知る者は、ほうきを持っておる。",
      "theme": "桜について",
      "aside": "ほうきはどこかの。",
      "tags": [
        "daily",
        "relationship"
      ]
    },
    {
      "id": "quiet-22",
      "mood": "quiet",
      "activeMonths": [
        6,
        7
      ],
      "text": "雨音は、心のざわめきを静める。\n洗濯物のざわめきまでは、静まらぬ。",
      "theme": "雨について",
      "aside": "まだ乾かんの。",
      "tags": [
        "rest",
        "daily"
      ]
    },
    {
      "id": "quiet-23",
      "mood": "quiet",
      "activeMonths": [
        7,
        8
      ],
      "text": "命の長さは、時間だけでは測れぬ。\n蝉の一声は、わしの長い説明より夏を残す。",
      "theme": "夏について",
      "aside": "説明はまだ続くぞい。",
      "tags": [
        "rest",
        "daily"
      ]
    },
    {
      "id": "quiet-24",
      "mood": "quiet",
      "activeMonths": [
        10,
        11
      ],
      "text": "移ろいを受け入れるのが悟りじゃ。\n落ち葉では滑るので、受け入れる前に足元を見る。",
      "theme": "秋について",
      "aside": "腰は大事じゃぞ。",
      "tags": [
        "daily",
        "rest"
      ]
    },
    {
      "id": "quiet-25",
      "mood": "quiet",
      "activeMonths": [
        12,
        1,
        2
      ],
      "text": "雪は昨日の跡を隠し、今日の跡をすぐ受け取る。\nまっさらな庭へ一歩出た。忘れ物に気づいて、同じ跡を戻った。",
      "theme": "雪について",
      "aside": "今度は羽織を着ておる。",
      "tags": [
        "daily",
        "creative"
      ]
    },
    {
      "id": "quiet-26",
      "mood": "quiet",
      "activeMonths": [
        6,
        7,
        8
      ],
      "text": "境目は、世界にあるより人が引くものかもしれぬ。\n夕暮れと夜の間で、蚊だけが迷わず刺してきた。",
      "theme": "夕暮れについて",
      "aside": "蚊には夜だったらしい。",
      "tags": [
        "rest",
        "daily"
      ]
    },
    {
      "id": "quiet-27",
      "mood": "quiet",
      "activeMonths": [
        1
      ],
      "text": "新しい年は、未来をまっさらしに見せる。\n戸棚には去年の餅が、まだ未来を待っておる。",
      "theme": "新年について",
      "aside": "焼けばいけるかの。",
      "tags": [
        "daily",
        "creative"
      ]
    },
    {
      "id": "quiet-28",
      "mood": "quiet",
      "text": "幸福へ至る道は、考えるほど遠くなる。\n猫は予定表も見ず、もう日なたにおる。",
      "theme": "猫について",
      "aside": "日なたは、あと半刻で動く。",
      "tags": [
        "rest",
        "daily"
      ]
    },
    {
      "id": "quiet-29",
      "mood": "quiet",
      "text": "心は言葉より先に、体へ現れる。\n犬はしっぽ、わしは眠いと眉毛がさらに下がる。",
      "theme": "素直さについて",
      "aside": "眉は寝ておる。",
      "tags": [
        "relationship",
        "daily"
      ]
    },
    {
      "id": "quiet-30",
      "mood": "quiet",
      "text": "集まりは、目的があるから生まれるとは限らぬ。\n鳩が三羽おる。議題はたぶん、パンじゃ。",
      "theme": "会議について",
      "aside": "わしは手ぶらで来てしもうた。",
      "tags": [
        "work",
        "daily"
      ]
    },
    {
      "id": "quiet-31",
      "mood": "quiet",
      "text": "遅いことと、止まっていることは違う。\n影は動いておるが、見ておっても分からん。",
      "theme": "歩みについて",
      "aside": "さっきより短いかの。",
      "tags": [
        "work",
        "rest"
      ]
    },
    {
      "id": "quiet-32",
      "mood": "quiet",
      "text": "言葉の重さは、声の大きさでは決まらぬ。\n雀の話は長いが、内容はまだ分からん。",
      "theme": "声について",
      "aside": "朝から元気じゃの。",
      "tags": [
        "relationship",
        "daily"
      ]
    },
    {
      "id": "quiet-33",
      "mood": "quiet",
      "text": "極みは、熱さの先にあるとは限らぬ。\nカピバラを見ておると、悟りはたぶん適温じゃ。",
      "theme": "適温について",
      "aside": "肩まで入るのじゃ。",
      "tags": [
        "rest",
        "daily"
      ]
    },
    {
      "id": "quiet-34",
      "mood": "quiet",
      "text": "同じ夜でも、見えるものは人によって違う。\n梟は真理を見て、わしはまぶたの裏を見ておる。",
      "theme": "夜について",
      "aside": "もう半分寝とる。",
      "tags": [
        "rest",
        "daily"
      ]
    },
    {
      "id": "quiet-35",
      "mood": "quiet",
      "text": "人は記憶を道具へ預け、自由になった。\n暗証番号を忘れたわしは、かなり自由じゃ。",
      "theme": "支払いについて",
      "aside": "顔認証も眠そうじゃ。",
      "tags": [
        "money",
        "daily"
      ]
    },
    {
      "id": "quiet-36",
      "mood": "quiet",
      "text": "知性は、答えの数では測れぬ。\n昼寝の理由を説明できぬわしにも、眠気だけは確かじゃ。",
      "theme": "AIについて",
      "aside": "理由より先に、まぶたが閉じる。",
      "tags": [
        "information",
        "daily"
      ]
    },
    {
      "id": "quiet-37",
      "mood": "quiet",
      "text": "価値は目に見えぬが、値段はよく見える。\n最近は育ちすぎて、わしの小銭を追い越した。",
      "theme": "物価について",
      "aside": "背比べは負けじゃ。",
      "tags": [
        "money",
        "daily"
      ]
    },
    {
      "id": "quiet-38",
      "mood": "quiet",
      "text": "そこにいることと、応じられることは同じではない。\n配達の人には、瞑想中のわしが留守に見えた。",
      "theme": "宅配について",
      "aside": "居留守ではないぞ。",
      "tags": [
        "daily",
        "rest"
      ]
    },
    {
      "id": "quiet-39",
      "mood": "quiet",
      "text": "世界は絶えず、こちらの注意を呼んでおる。\n今日は湯が沸く音だけに返事する。",
      "theme": "通知について",
      "aside": "湯が沸いたぞ。",
      "tags": [
        "information",
        "rest"
      ]
    },
    {
      "id": "quiet-40",
      "mood": "quiet",
      "text": "距離を越えて顔が見える時代になった。\nわしの相槌は、ミュートを越えられんかった。",
      "theme": "オンラインについて",
      "aside": "うなずきは届いたらしい。",
      "tags": [
        "work",
        "relationship"
      ]
    },
    {
      "id": "foggy-21",
      "mood": "foggy",
      "activeMonths": [
        2,
        3,
        4
      ],
      "text": "原因と結果を見分けるのは難しい。\n春が眠いのか、わしが眠いのか。花粉は黙っておる。",
      "theme": "春眠について",
      "aside": "目は開かんの。",
      "tags": [
        "rest",
        "daily"
      ]
    },
    {
      "id": "foggy-22",
      "mood": "foggy",
      "activeMonths": [
        6,
        7
      ],
      "text": "備えとは、使わずに済んだとき完成する。\n傘を忘れた日だけ、空は完成を急ぐ。",
      "theme": "梅雨について",
      "aside": "軒下で一句ひねっておる。",
      "tags": [
        "daily",
        "creative"
      ]
    },
    {
      "id": "foggy-23",
      "mood": "foggy",
      "activeMonths": [
        6,
        7,
        8,
        9
      ],
      "text": "思考は環境から自由ではない。\nわしは暑さで考えが溶け、冷房のリモコンまで見失った。",
      "theme": "猛暑について",
      "aside": "冷蔵庫には入れんぞ。",
      "tags": [
        "rest",
        "daily"
      ]
    },
    {
      "id": "foggy-24",
      "mood": "foggy",
      "activeMonths": [
        8,
        9,
        10
      ],
      "text": "未来の進路は、風ひとつで形を変える。\nわしの予定は、昼寝ひとつで曲がった。",
      "theme": "進路について",
      "aside": "まず戸を閉めるぞ。",
      "tags": [
        "daily",
        "work"
      ]
    },
    {
      "id": "foggy-25",
      "mood": "foggy",
      "activeMonths": [
        9,
        10,
        11
      ],
      "text": "人は一日の中でも、同じ自分ではない。\n朝のわしと昼のわしが、羽織を取り合っておる。",
      "theme": "季節の境目について",
      "aside": "羽織は持ったかの。",
      "tags": [
        "daily",
        "creative"
      ]
    },
    {
      "id": "foggy-26",
      "mood": "foggy",
      "activeMonths": [
        12,
        1,
        2
      ],
      "text": "行動には理由が必要だと、人は考える。\n布団を探したが、出る理由だけ見つからん。",
      "theme": "冬の朝について",
      "aside": "もう少し探すかの。",
      "tags": [
        "rest",
        "daily"
      ]
    },
    {
      "id": "foggy-27",
      "mood": "foggy",
      "activeMonths": [
        3,
        4,
        9,
        10,
        11
      ],
      "text": "変化へ備えるうちにも、世界は変わり続ける。\n衣替えの途中で、押し入れが四季になった。",
      "theme": "衣替えについて",
      "aside": "半袖に羽織じゃ。",
      "tags": [
        "daily",
        "work"
      ]
    },
    {
      "id": "foggy-28",
      "mood": "foggy",
      "text": "試すことは、測ることより先に来てよい。\n猫は箱に入ってから、大きさを考えておる。",
      "theme": "試すことについて",
      "aside": "しっぽは出とるぞい。",
      "tags": [
        "creative",
        "daily"
      ]
    },
    {
      "id": "foggy-29",
      "mood": "foggy",
      "text": "失くすと拾うは、同じ出来事の裏と表じゃ。\n烏が光るものを見つけた。わしの眼鏡かもしれん。",
      "theme": "発見について",
      "aside": "予備は、どこかにあるはずじゃ。",
      "tags": [
        "daily",
        "information"
      ]
    },
    {
      "id": "foggy-30",
      "mood": "foggy",
      "text": "導くつもりが、導かれておることがある。\n犬に散歩される人を見た。行き先は犬だけ知っておる。",
      "theme": "導くことについて",
      "aside": "足取りは軽いの。",
      "tags": [
        "relationship",
        "rest"
      ]
    },
    {
      "id": "foggy-31",
      "mood": "foggy",
      "text": "人は、理由を知る前に列へ加わる。\nペンギンの最後尾に立ってから、何の列かを考えた。",
      "theme": "行列について",
      "aside": "前の人も、そわそわしておる。",
      "tags": [
        "relationship",
        "daily"
      ]
    },
    {
      "id": "foggy-32",
      "mood": "foggy",
      "text": "どこで考えるかは、何を考えるかと同じくらい大事じゃ。\n鹿は道の真ん中で考え、警笛に急かされておった。",
      "theme": "立ち止まることについて",
      "aside": "端で考えるかの。",
      "tags": [
        "daily",
        "work"
      ]
    },
    {
      "id": "foggy-33",
      "mood": "foggy",
      "text": "足りぬのは手の数ではなく、抱えた用事の数じゃ。\n蛸に八本あっても、足りぬ日はあろう。",
      "theme": "忙しさについて",
      "aside": "二本でも余っとる。",
      "tags": [
        "work",
        "rest"
      ]
    },
    {
      "id": "foggy-34",
      "mood": "foggy",
      "text": "守りを固めるほど、持ち主も遠ざかる。\n合言葉を安全な場所へしまい、そこへ入れぬ。",
      "theme": "パスワードについて",
      "aside": "秘密は守られたの。",
      "tags": [
        "information",
        "daily"
      ]
    },
    {
      "id": "foggy-35",
      "mood": "foggy",
      "text": "便利になるほど、間に手順が一つ増える。\n献立を読み込む前に、腹のほうが鳴った。",
      "theme": "電子メニューについて",
      "aside": "紙はないのかの。",
      "tags": [
        "information",
        "daily"
      ]
    },
    {
      "id": "foggy-36",
      "mood": "foggy",
      "text": "短くした言葉と、深くなった理解は別物じゃ。\n長い話を縮めてもらい、わしの理解も縮んだ。",
      "theme": "要約について",
      "aside": "三行でも長いかの。",
      "tags": [
        "information",
        "work"
      ]
    },
    {
      "id": "foggy-37",
      "mood": "foggy",
      "text": "手段は、目的より記憶に残りやすい。\n集めた印は覚えておるが、何を買ったかは忘れた。",
      "theme": "ポイントについて",
      "aside": "あと一つで何じゃ。",
      "tags": [
        "money",
        "daily"
      ]
    },
    {
      "id": "foggy-38",
      "mood": "foggy",
      "text": "知らせを追うほど先が見えぬ。\n鳩の便りくらいでよいかの。",
      "theme": "ニュースについて",
      "aside": "今日は誰も来ておらん。",
      "tags": [
        "information",
        "rest"
      ]
    },
    {
      "id": "foggy-39",
      "mood": "foggy",
      "text": "道に詳しいことと、道を行くことは別じゃ。\n荷物を運ぶ機械は詳しいが、わしは乗れん。",
      "theme": "配達ロボットについて",
      "aside": "荷物になれば乗れるかの。",
      "tags": [
        "information",
        "daily"
      ]
    },
    {
      "id": "foggy-40",
      "mood": "foggy",
      "text": "同意する前に全部読もうとした。\n季節が一つ過ぎた。",
      "theme": "利用規約について",
      "aside": "まだ第一章じゃ。",
      "tags": [
        "information",
        "daily"
      ]
    },
    {
      "id": "thinking-21",
      "mood": "thinking",
      "activeMonths": [
        3,
        4
      ],
      "text": "世界には、管理せずとも巡る秩序がある。\n桜は会議招待も出さぬが、毎年ちゃんと咲く。",
      "theme": "巡りについて",
      "aside": "わしの手帳は空いておる。",
      "tags": [
        "work",
        "daily"
      ]
    },
    {
      "id": "thinking-22",
      "mood": "thinking",
      "activeMonths": [
        6,
        7,
        8,
        9
      ],
      "text": "近づくことが、いつも親しさとは限らぬ。\n気温と体温には、少し距離を置いてほしい。",
      "theme": "暑さについて",
      "aside": "水を飲むのじゃ。",
      "tags": [
        "rest",
        "daily"
      ]
    },
    {
      "id": "thinking-23",
      "mood": "thinking",
      "activeMonths": [
        9,
        10,
        11
      ],
      "text": "季節が深まると、人は内側へ意識を向ける。\nわしの内側は、栗の場所ばかり尋ねておる。",
      "theme": "秋について",
      "aside": "腹も思想家じゃ。",
      "tags": [
        "rest",
        "creative"
      ]
    },
    {
      "id": "thinking-24",
      "mood": "thinking",
      "activeMonths": [
        11,
        12,
        1,
        2,
        3
      ],
      "text": "最善を考えるほど、行動は遅れることがある。\n暖房か靴下か。考えている今が一番寒い。",
      "theme": "冬支度について",
      "aside": "まず靴下じゃ。",
      "tags": [
        "daily",
        "rest"
      ]
    },
    {
      "id": "thinking-25",
      "mood": "thinking",
      "activeMonths": [
        12
      ],
      "text": "区切りとは、人が時間に引いた線じゃ。\n仕事を片づける前に、年のほうが線を越えた。",
      "theme": "年末について",
      "aside": "来年のわし、頼んだぞ。",
      "tags": [
        "work",
        "rest"
      ]
    },
    {
      "id": "thinking-26",
      "mood": "thinking",
      "activeMonths": [
        3,
        4,
        9,
        10
      ],
      "text": "未来を先取りするとは、まだない季節に服を置くことじゃ。\n季節が来る前に、置いた場所を忘れた。",
      "theme": "先取りについて",
      "aside": "まだ札が付いとるぞい。",
      "tags": [
        "money",
        "daily"
      ]
    },
    {
      "id": "thinking-27",
      "mood": "thinking",
      "text": "蟻は働き者じゃという。\n休憩中の蟻には聞いてない。",
      "theme": "働き方について",
      "aside": "わしも今は休憩中じゃ。",
      "tags": [
        "work",
        "rest"
      ]
    },
    {
      "id": "thinking-28",
      "mood": "thinking",
      "text": "役割を分けると、働きは滑らかになる。\n蜂が運び、花が待つ。わしは花の役を選んだ。",
      "theme": "役割について",
      "aside": "日当たりもよいぞ。",
      "tags": [
        "work",
        "relationship"
      ]
    },
    {
      "id": "thinking-29",
      "mood": "thinking",
      "text": "帰る力と、たどり着く力は別のものらしい。\n渡り鳥は地図なしで帰り、わしは駅の出口で迷う。",
      "theme": "帰る場所について",
      "aside": "北口はどっちじゃ。",
      "tags": [
        "relationship",
        "daily"
      ]
    },
    {
      "id": "thinking-30",
      "mood": "thinking",
      "text": "備えは、置いた場所を忘れた日に失くし物へ変わる。\n栗鼠は木の実を隠し、場所も隠したらしい。",
      "theme": "備えについて",
      "aside": "わしの団子もない。",
      "tags": [
        "money",
        "daily"
      ]
    },
    {
      "id": "thinking-31",
      "mood": "thinking",
      "text": "迷いは、選べぬときだけでなく、譲ろうとするときにも生まれる。\n猫が椅子からどくのを待った。猫は昼寝を始めた。",
      "theme": "決断について",
      "aside": "わしは床に座っておる。",
      "tags": [
        "relationship",
        "rest"
      ]
    },
    {
      "id": "thinking-32",
      "mood": "thinking",
      "text": "会話の長さは、話した内容の量とは違う。\nわしは相槌だけで、半日を会話にできる。",
      "theme": "会話について",
      "aside": "うむ、ほう、なるほどの。",
      "tags": [
        "relationship",
        "daily"
      ]
    },
    {
      "id": "thinking-33",
      "mood": "thinking",
      "text": "梟は賢そうな顔をしておる。\n黙っている時間が長いからかの。",
      "theme": "沈黙について",
      "aside": "わしは今日、よく喋った。",
      "tags": [
        "information",
        "relationship"
      ]
    },
    {
      "id": "thinking-34",
      "mood": "thinking",
      "text": "選択肢が増えると、迷いも同じだけ増える。\nAIに正解を三つもらい、三倍迷っておる。",
      "theme": "正解について",
      "aside": "四つ目は聞かぬでおく。",
      "tags": [
        "information",
        "work"
      ]
    },
    {
      "id": "thinking-35",
      "mood": "thinking",
      "text": "小さく分けられたものは、記憶に残る大きさを失う。\n毎月払っておるが、何に払ったかは覚えておらん。",
      "theme": "定額について",
      "aside": "解約の入口が見えぬ。",
      "tags": [
        "money",
        "information"
      ]
    },
    {
      "id": "thinking-36",
      "mood": "thinking",
      "text": "値段が上がると、人は理由まで買わされる。\n団子の説明は長くなったが、大きさは変わらん。",
      "theme": "値上がりについて",
      "aside": "説明は腹にたまらぬ。",
      "tags": [
        "money",
        "daily"
      ]
    },
    {
      "id": "thinking-37",
      "mood": "thinking",
      "text": "家でも仕事はできる。\n仕事をしないことも、よくできる。",
      "theme": "働く場所について",
      "aside": "布団が近すぎるんじゃ。",
      "tags": [
        "work",
        "rest"
      ]
    },
    {
      "id": "thinking-38",
      "mood": "thinking",
      "text": "選ばされた時間も、自分で選んだ一日に見える。\nおすすめだけ見て日が暮れた。",
      "theme": "おすすめについて",
      "aside": "次も見よ、と出ておる。",
      "tags": [
        "information",
        "daily"
      ]
    },
    {
      "id": "thinking-39",
      "mood": "thinking",
      "text": "積み上げたものは、片づけたものと違って高さが見える。\n未読の山に登っても、返信は一つも減らん。",
      "theme": "未読について",
      "aside": "まず下山するかの。",
      "tags": [
        "work",
        "information"
      ]
    },
    {
      "id": "thinking-40",
      "mood": "thinking",
      "text": "遠くへ届く知性ほど、近くを見落とすことがある。\n月へ行く機械を眺めて、茶を取りに来たことを忘れた。",
      "theme": "宇宙について",
      "aside": "月より台所が遠いのじゃ。",
      "tags": [
        "creative",
        "information"
      ]
    },
    {
      "id": "quiet-41",
      "mood": "quiet",
      "text": "繰り返した動きは、考えるより先に手が動く。\n靴を履いてから、どこへ行くのか思い出した。",
      "theme": "習慣について",
      "aside": "鍵は持ったかの。",
      "tags": [
        "daily"
      ]
    },
    {
      "id": "quiet-42",
      "mood": "quiet",
      "text": "聞くとは、言葉の続きを急がず待つことじゃ。\n相手が黙ったので続きを待った。相手は返事を待っておった。",
      "theme": "聞くことについて",
      "aside": "二人で茶だけ飲んでおる。",
      "tags": [
        "relationship",
        "daily"
      ]
    },
    {
      "id": "quiet-43",
      "mood": "quiet",
      "text": "手放せぬものは、たいてい置き場所が決まっておる。\n捨てられぬ箱は、いつも同じ棚の同じ角じゃ。",
      "theme": "執着について",
      "aside": "中身は見ておらん。",
      "tags": [
        "daily"
      ]
    },
    {
      "id": "quiet-44",
      "mood": "quiet",
      "text": "親切は、受け取る側の都合で重さが変わる。\n腹一杯の者に団子を渡すと、荷物になる。",
      "theme": "親切について",
      "aside": "半分だけ渡すかの。",
      "tags": [
        "relationship",
        "daily"
      ]
    },
    {
      "id": "quiet-45",
      "mood": "quiet",
      "text": "人との距離は、黙っていても困らぬときに少し縮まる。\n初めて会った人と半刻黙った。茶だけは三杯進んだ。",
      "theme": "距離について",
      "aside": "四杯目を沸かしておる。",
      "tags": [
        "relationship"
      ]
    },
    {
      "id": "quiet-46",
      "mood": "quiet",
      "text": "許しは、過去より次の行動に現れる。\n昨日座布団を取った猫のために、今日はもう一枚敷いておいた。",
      "theme": "許すことについて",
      "aside": "猫は二枚とも使っておる。",
      "tags": [
        "relationship",
        "daily"
      ]
    },
    {
      "id": "quiet-47",
      "mood": "quiet",
      "text": "相談とは、答えを聞く場ではないことがある。\n茶を出すと、たいてい先に片がつく。",
      "theme": "相談について",
      "aside": "二杯目は要らぬらしい。",
      "tags": [
        "relationship",
        "work"
      ]
    },
    {
      "id": "quiet-48",
      "mood": "quiet",
      "text": "旨いと感じるのは、舌より前の空腹かもしれぬ。\n同じ飯が、走った日だけ違う顔をする。",
      "theme": "味について",
      "aside": "今日は普通じゃ。",
      "tags": [
        "daily"
      ]
    },
    {
      "id": "quiet-49",
      "mood": "quiet",
      "text": "古い物が重いのは、値打ちより迷った時間が入っておるからじゃ。\n空き箱を半刻眺めた。今日も同じ棚へ戻した。",
      "theme": "物について",
      "aside": "中身はずっと空じゃ。",
      "tags": [
        "daily"
      ]
    },
    {
      "id": "quiet-50",
      "mood": "quiet",
      "text": "見えぬ働きは、なくなった日にいちばんよく見える。\n出汁を入れ忘れた。汁の中で、湯だけが堂々としておる。",
      "theme": "支度について",
      "aside": "今日は薄味ということにした。",
      "tags": [
        "daily",
        "work"
      ]
    },
    {
      "id": "quiet-51",
      "mood": "quiet",
      "text": "近くを見るには、遠ざけねばならぬことがある。\n献立が近いと字がぼやける。腕いっぱい遠ざけたら、隣の人が読んでくれた。",
      "theme": "見ることについて",
      "aside": "今日は豆腐にした。",
      "tags": [
        "daily"
      ]
    },
    {
      "id": "quiet-52",
      "mood": "quiet",
      "text": "風の強さは、立っておっては分からぬ。\n障子の紙が、いつも先に知らせてくる。",
      "theme": "風について",
      "aside": "そろそろ張り替えかの。",
      "tags": [
        "daily"
      ]
    },
    {
      "id": "quiet-53",
      "mood": "quiet",
      "text": "慣れるとは、驚かなくなることじゃ。\n毎日飲む茶の味を、いつから確かめておらん。",
      "theme": "慣れについて",
      "aside": "今日は一口目を味わう。",
      "tags": [
        "daily",
        "rest"
      ]
    },
    {
      "id": "quiet-54",
      "mood": "quiet",
      "text": "退屈は、何もないときではなく、何かを待つときに来る。\n座っておるだけなら、そう悪くない。",
      "theme": "退屈について",
      "aside": "日なたが動いておる。",
      "tags": [
        "rest"
      ]
    },
    {
      "id": "quiet-55",
      "mood": "quiet",
      "text": "残すために撮ると、見る時間が後ろへずれる。\nわしの秋は、まだ箱の中で待っておる。",
      "theme": "記録について",
      "aside": "去年の分もある。",
      "tags": [
        "daily",
        "creative"
      ]
    },
    {
      "id": "quiet-56",
      "mood": "quiet",
      "text": "真似は、同じものを目指すほど違いを残す。\n鶴を見て一羽描いた。わしのだけ、ずいぶんわしに似ておる。",
      "theme": "真似について",
      "aside": "眉を濃く描きすぎた。",
      "tags": [
        "creative"
      ]
    },
    {
      "id": "quiet-57",
      "mood": "quiet",
      "text": "待つことの上手い者は、退屈と付き合いが長い。\n釣り人と猫は、同じ顔で座っておる。",
      "theme": "待つことについて",
      "aside": "わしも並ぶかの。",
      "tags": [
        "rest",
        "daily"
      ]
    },
    {
      "id": "foggy-41",
      "mood": "foggy",
      "text": "覚えておくとは、どこかへ置くことじゃ。\n置いた場所を覚える者が、別に要るのではないか。",
      "theme": "記憶について",
      "aside": "手帳を探しておる。",
      "tags": [
        "daily",
        "information"
      ]
    },
    {
      "id": "foggy-42",
      "mood": "foggy",
      "text": "決めた予定は、決めた時点の自分のものじゃ。\n明日の自分は、まだ何も約束しておらん。",
      "theme": "予定について",
      "aside": "印だけは丸くつけた。",
      "tags": [
        "work",
        "daily"
      ]
    },
    {
      "id": "foggy-43",
      "mood": "foggy",
      "text": "言葉にすると、輪郭のなかったものに角ができる。\n悩みを口に出したら、四角くなって転がらん。",
      "theme": "言葉について",
      "aside": "転がるほうが楽かの。",
      "tags": [
        "daily",
        "relationship"
      ]
    },
    {
      "id": "foggy-44",
      "mood": "foggy",
      "text": "一つを選ぶたび、選ばなかった未来を一つ手放す。\n蕎麦を頼んだので、丼を食べたわしは今日は現れぬ。",
      "theme": "選択について",
      "aside": "隣の丼は、まだ湯気を立てておる。",
      "tags": [
        "daily"
      ]
    },
    {
      "id": "foggy-45",
      "mood": "foggy",
      "text": "決められぬのは、どちらも悪くないからじゃ。\n昼寝と散歩で半刻迷い、どちらも逃した。",
      "theme": "決断について",
      "aside": "座ったまま暮れたの。",
      "tags": [
        "rest",
        "daily"
      ]
    },
    {
      "id": "foggy-46",
      "mood": "foggy",
      "text": "早く済ませた仕事の分だけ、別の仕事が来る。\n朝に一束終えた。次が来ぬよう、空いた机へ茶と団子を並べた。",
      "theme": "仕事量について",
      "aside": "次の書類は膝に置かれた。",
      "tags": [
        "work"
      ]
    },
    {
      "id": "foggy-47",
      "mood": "foggy",
      "text": "貯めるとは、今使わぬ理由を未来へ預けることじゃ。\n十年前から小銭を壺へ入れておる。未来は来たが、使う日はまだ先らしい。",
      "theme": "貯えについて",
      "aside": "今日も一枚入れた。",
      "tags": [
        "money"
      ]
    },
    {
      "id": "foggy-48",
      "mood": "foggy",
      "text": "眠りは、意識して手放すことのできぬ数少ないものじゃ。\n力を抜こうと力を入れて、朝になった。",
      "theme": "眠りについて",
      "aside": "枕は悪くない。",
      "tags": [
        "rest"
      ]
    },
    {
      "id": "foggy-49",
      "mood": "foggy",
      "text": "やらぬ理由は、探せばいくらでも出てくる。\n今日は腰と天気の二つが手を挙げた。",
      "theme": "言い訳について",
      "aside": "多数決には弱いのじゃ。",
      "tags": [
        "daily"
      ]
    },
    {
      "id": "foggy-50",
      "mood": "foggy",
      "text": "習慣になった選択は、決めたことまで忘れさせる。\n今朝は違う羽織を選んだつもりだった。鏡には、昨日と同じ羽織のわしがおった。",
      "theme": "服について",
      "aside": "違ったのは帯だけじゃ。",
      "tags": [
        "daily"
      ]
    },
    {
      "id": "foggy-51",
      "mood": "foggy",
      "text": "合うかどうかは、選んだ場所より使う場所で分かる。\n店では仲よくできそうだった靴が、帰り道で踵と喧嘩を始めた。",
      "theme": "選び方について",
      "aside": "今は手に持っておる。",
      "tags": [
        "daily"
      ]
    },
    {
      "id": "foggy-52",
      "mood": "foggy",
      "text": "朝は、昨日決めたことを疑う時間らしい。\n夜のわしは、いつも他人のように強気じゃ。",
      "theme": "朝について",
      "aside": "起きてから考える。",
      "tags": [
        "rest",
        "daily"
      ]
    },
    {
      "id": "foggy-53",
      "mood": "foggy",
      "text": "変わったのは自分か、周りか。\n引き出しの取っ手が固くなったのか、手が弱ったのか。",
      "theme": "変化について",
      "aside": "油を差してみるかの。",
      "tags": [
        "daily"
      ]
    },
    {
      "id": "foggy-54",
      "mood": "foggy",
      "text": "独り言は、聞き手のおらぬ相談じゃ。\n答えも自分で出すので、たいてい話が早い。",
      "theme": "独り言について",
      "aside": "たまに反対もする。",
      "tags": [
        "daily"
      ]
    },
    {
      "id": "foggy-55",
      "mood": "foggy",
      "text": "知らせは、届いた順に届く。\n大事なものから読むには、先に全部読まねばならぬ。",
      "theme": "知らせについて",
      "aside": "まだ一通目を眺めておる。",
      "tags": [
        "information"
      ]
    },
    {
      "id": "foggy-56",
      "mood": "foggy",
      "text": "安く買えたと思うとき、比べておるのは値札同士じゃ。\n要るかどうかは、まだ誰も聞いておらん。",
      "theme": "買い物について",
      "aside": "袋だけ増えたの。",
      "tags": [
        "money",
        "daily"
      ]
    },
    {
      "id": "foggy-57",
      "mood": "foggy",
      "text": "降るかどうかは空が決め、傘を持つかは自分で決める。\n傘を持つか半刻考えた。空のほうは、もう決めたらしい。",
      "theme": "天気について",
      "aside": "わしはまだ玄関におる。",
      "tags": [
        "daily"
      ]
    },
    {
      "id": "thinking-41",
      "mood": "thinking",
      "text": "時間の速さは、測る側の都合で変わるらしい。\n湯が沸くまでは長く、飲むうちに冷めるのは早い。",
      "theme": "時間について",
      "aside": "二杯目は急がぬ。",
      "tags": [
        "rest",
        "daily"
      ]
    },
    {
      "id": "thinking-42",
      "mood": "thinking",
      "text": "年を取るとは、同じ話を二度する権利を得ることじゃ。\nわしは三度目からが本番と決めておる。",
      "theme": "年月について",
      "aside": "茶を出す係がおらん。",
      "tags": [
        "daily",
        "relationship"
      ]
    },
    {
      "id": "thinking-43",
      "mood": "thinking",
      "text": "分かりやすく説明できることと、分かっていることは違う。\n団子の旨さを説明できたが、旨くはならん。",
      "theme": "説明について",
      "aside": "もう一本もらうかの。",
      "tags": [
        "information",
        "daily"
      ]
    },
    {
      "id": "thinking-44",
      "mood": "thinking",
      "text": "自由には、たいてい維持費がかかる。\n出かけぬ自由を守るために、家賃を払っておる。",
      "theme": "自由について",
      "aside": "今月分は払った。",
      "tags": [
        "money",
        "daily"
      ]
    },
    {
      "id": "thinking-45",
      "mood": "thinking",
      "text": "人と比べるとき、相手の一番と自分の平均を並べてしまう。\nわしは団子の数だけ勝っておる。",
      "theme": "比較について",
      "aside": "数える相手がおらん。",
      "tags": [
        "relationship",
        "daily"
      ]
    },
    {
      "id": "thinking-46",
      "mood": "thinking",
      "text": "急ぎの用事は、他の用事を静かにさせる。\n机の上が急に片づいたのは、そのせいじゃ。",
      "theme": "仕事について",
      "aside": "元に戻る頃かの。",
      "tags": [
        "work",
        "daily"
      ]
    },
    {
      "id": "thinking-47",
      "mood": "thinking",
      "text": "準備が整うのを待つ者は、たいてい始めぬ。\n包丁を研ぐうちに、飯の刻限が過ぎた。",
      "theme": "準備について",
      "aside": "よく切れるようになった。",
      "tags": [
        "work",
        "daily"
      ]
    },
    {
      "id": "thinking-48",
      "mood": "thinking",
      "text": "腹が減ると、考えの角が立つ。\n世界の不条理は、飯のあとに半分に減った。",
      "theme": "空腹について",
      "aside": "残りは明日考えるかの。",
      "tags": [
        "daily",
        "rest"
      ]
    },
    {
      "id": "thinking-49",
      "mood": "thinking",
      "text": "片づけは、探す時間の先払いじゃ。\n昨日眼鏡を片づけた。今日は、どこへ片づけたかを探しておる。",
      "theme": "片づけについて",
      "aside": "予備の眼鏡は掛けておる。",
      "tags": [
        "daily",
        "work"
      ]
    },
    {
      "id": "thinking-50",
      "mood": "thinking",
      "text": "正しさは、持っていると誰かへ向けたくなる。\nわしは棚へ置いて、たまに眺めることにした。",
      "theme": "正しさについて",
      "aside": "埃はかぶっておらん。",
      "tags": [
        "relationship"
      ]
    },
    {
      "id": "thinking-51",
      "mood": "thinking",
      "text": "期待とは、まだ起きておらぬことへの前払いじゃ。\n釣りは、たいてい返ってこん。",
      "theme": "期待について",
      "aside": "領収書はないの。",
      "tags": [
        "relationship",
        "money"
      ]
    },
    {
      "id": "thinking-52",
      "mood": "thinking",
      "text": "数えると安心するのは、増減が見えるからじゃ。\n積んだ本を数えたら三十冊あった。今年買った本と同じ数じゃ。",
      "theme": "数について",
      "aside": "今日もう一冊届いた。",
      "tags": [
        "information",
        "daily"
      ]
    },
    {
      "id": "thinking-53",
      "mood": "thinking",
      "text": "探しやすい場所と、見つかる場所は同じとは限らぬ。\n鍵を失くした。玄関は暗いので、明るい机の上だけ探しておった。",
      "theme": "調べることについて",
      "aside": "鍵は玄関にあった。",
      "tags": [
        "information",
        "work"
      ]
    },
    {
      "id": "thinking-54",
      "mood": "thinking",
      "text": "問いを理解することと、返事をすることは別の仕事じゃ。\n先に「うむ」と答えた。相手が帰ってから、何を聞かれたか考えておる。",
      "theme": "返事について",
      "aside": "たぶん引き受けたんじゃ。",
      "tags": [
        "work",
        "information"
      ]
    },
    {
      "id": "thinking-55",
      "mood": "thinking",
      "text": "作るとは、まだないもののために場所を空けることじゃ。\n朝から机を片づけた。場所が空いたころには、日が暮れておった。",
      "theme": "作ることについて",
      "aside": "紙はまだ白い。",
      "tags": [
        "creative",
        "work"
      ]
    },
    {
